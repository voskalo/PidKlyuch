{
	email {$ACME_EMAIL:admin@example.com}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	# Security headers on every response. "-Server" also removes the "Caddy" and "uvicorn" server names
	# (deferred, so it applies to proxied responses too). frame-ancestors/X-Frame-Options stop clickjacking.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Vite puts a content hash in every file name under /assets/, so they can be cached for a year.
	# Everything else on the UI side (index.html, SPA routes) must be revalidated, so a deploy shows up at once.
	@hashed_assets path /assets/*
	header @hashed_assets Cache-Control "public, max-age=31536000, immutable"
	@ui_pages {
		not path /assets/* /api/* /docs* /openapi.json /healthz
	}
	header @ui_pages Cache-Control "no-cache"

	handle /healthz {
		respond "OK" 200
	}

	handle /api/docs* {
		uri strip_prefix /api
		reverse_proxy backend:8000
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /docs* {
		reverse_proxy backend:8000
	}

	handle /openapi.json {
		reverse_proxy backend:8000
	}

	# Route all UI requests to frontend in full-stack mode, with seamless fallback
	# to the Day 1 hello-world page when started via `--profile fallback`.
	handle {
		reverse_proxy frontend:80 hello:80 {
			lb_policy first
			lb_retries 1
			lb_try_duration 2s
			fail_duration 10s
		}
	}
}
