# Copy to infra/.env and customize before running production Docker Compose.
# NEVER commit infra/.env to git.

# --- Caddy v2 & Automatic HTTPS ---
# Local dev: localhost
# AWS EC2 automatic HTTPS without buying DNS: <EC2-PUBLIC-IP-WITH-DASHES>.sslip.io (e.g. 3-75-120-45.sslip.io)
DOMAIN=localhost
ACME_EMAIL=admin@example.com

# --- PostgreSQL (Compose `db` service) ---
POSTGRES_USER=pidklyuch
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=pidklyuch

# --- Backend (FastAPI / SQLAlchemy / Auth) ---
# Leave pointing to Compose `db`, or replace with AWS RDS endpoint + ?sslmode=require:
# DATABASE_URL=postgresql+psycopg://user:password@<rds-endpoint>:5432/pidklyuch?sslmode=require
DATABASE_URL=postgresql+psycopg://pidklyuch:change-me-strong-db-password@db:5432/pidklyuch

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-secret
JWT_EXPIRE_MINUTES=10080

# Include the public HTTPS origin in production, e.g. https://3-75-120-45.sslip.io
CORS_ORIGINS=https://localhost,http://localhost:5173,http://localhost:3000
NBU_API_URL=https://bank.gov.ua/NBUStatService/v1/statdirectory/exchange?json
# Optional: Google OAuth 2.0 Web Client ID (must match VITE_GOOGLE_CLIENT_ID below to enable Google Sign-In)
GOOGLE_CLIENT_ID=

# --- Frontend (Vite build args) ---
# Leave empty when served through Caddy on the same HTTPS origin (frontend/src/services/api.ts already prefixes /api)
VITE_API_BASE_URL=
# Optional: Google OAuth 2.0 Web Client ID for Google Identity Services button
VITE_GOOGLE_CLIENT_ID=
