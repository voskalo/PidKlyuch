# Copy to .env and adjust. Never commit .env.
# SQLAlchemy URL. Local default is SQLite; in production use Postgres, e.g.
# postgresql+psycopg://user:password@host:5432/pidklyuch
DATABASE_URL=sqlite:///./pidklyuch.db
# Secret for signing JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=10080
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# NBU exchange-rate API
NBU_API_URL=https://bank.gov.ua/NBUStatService/v1/statdirectory/exchange?json
# Optional: load tax rates from another file (default: app/customs/tax_rates.json),
# e.g. a file synced from S3, to change rates without a redeploy.
# TAX_RATES_PATH=/mnt/config/tax_rates.json
# Optional: Google OAuth 2.0 Web Client ID for "Sign in with Google" (POST /api/auth/google)
GOOGLE_CLIENT_ID=
